      \field{journaltitle}{International Journal of Qualitative Methods}
      \field{month}{10}
      \field{shortjournal}{International Journal of Qualitative Methods}
      \field{shorttitle}{Sample {{Sizes}} for 10 {{Types}} of {{Qualitative Data Analysis}}}
